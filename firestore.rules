// Firestoreのセキュリティルール
//
// このファイルはFirebaseコンソールの
//   Firestore Database → ルール
// に貼り付けて「公開」することで有効になる。
// (アプリの動作には含まれないため、ここに置いてあるだけでは反映されない)
//
// {document=**} は「その下の階層すべて」を表す再帰ワイルドカード。
// これを付けないと users/{userId}/logs/{logId} の1階層だけが対象になり、
// その下の抽出記録(users/{userId}/logs/{logId}/brews/{brewId})は
// 許可の記述が無い状態＝アクセス拒否になってしまう。

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ログイン中の本人だけが、自分のデータ(配下のサブコレクションを含む)を読み書きできる
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

  }
}
